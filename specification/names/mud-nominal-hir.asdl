-- Alias operator declarations/operands retain SurfaceRef provenance.
-- Their candidate/identity contract remains unspecified; no selected target,
-- inferred operand/result type or type-dependent anchor is manufactured.
-- Named pattern leaves use ordinary computed/stored/iterator LocalSymbol kinds.
-- Ordinals follow textual depth-first leaf order; discards create no symbol or edge.
-- Type holes have SurfaceRef provenance only, no symbol, inferred type or HIR payload.
-- File/part catalogues enforce part-only and direct uses before lookup.
-- Normal/sub operations create their own nominal categories and anchors.
-- Part headers and uses declarations create no symbols, owners or anchors;
-- no visibility, callable-capability or contract-type proof is stored here.
-- Generic parameters use LocalSymbol kind type-parameter in a joint header/body scope.
-- Application constructors/arguments keep SurfaceRef provenance and ordinary bindings.
-- Applications create no symbols or anchors. Specializes retains source constructors;
-- effective application ancestry, inferred arguments and closure proofs are elaboration.
-- PendingReceiverCall also defers static written-given compatibility, without storing it.

module MUDNominalHIR {
    source_span = SourceSpan(string file, int start_byte, int end_byte)
    anchor = Anchor(string value)
    scope_id = ScopeId(int value)

    -- Handler captures use LocalSymbol kind error-binding and clause-local scopes.
    -- Error typing and pending occurrence matching belong to later phases.
    symbol_id = AnchoredSymbol(anchor value)
              | LocalSymbol(anchor owner, string kind, string name, int ordinal)

    surface_ref = SurfaceRef(source_span origin, string role)

    nominal_project = NominalHIR(nominal_symbol* symbols,
                                 nominal_scope* scopes,
                                 nominal_reference* bindings,
                                 nominal_edge* edges)

    nominal_symbol = NominalSymbol(symbol_id identity,
                                   symbol_id? owner,
                                   string category,
                                   string source_name,
                                   scope_id scope,
                                   surface_ref declaration)

    nominal_scope = NominalScope(scope_id identity,
                                 scope_id? parent,
                                 symbol_id? owner,
                                 scope_entry* entries)

    scope_entry = ScopeEntry(string name, symbol_id symbol)

    lookup_level = LexicalLevel | OwnerLevel | CurrentPathLevel
                 | ExactUsingLevel | RecursiveUsingLevel | BuiltinLevel

    nominal_reference = ResolvedReference(surface_ref occurrence,
                                         symbol_id target,
                                         string role)
                      | PendingReceiverCall(surface_ref occurrence,
                                             symbol_id* candidates,
                                             lookup_level level,
                                             string role)

    nominal_edge = Owns(symbol_id owner, symbol_id member)
                 | Specializes(symbol_id derived, symbol_id base)
                 | RefersTo(symbol_id source, symbol_id target)
}
