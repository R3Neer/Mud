    {
      "id": "redundant-create",
      "contract": "redundant create",
      "witness": {
        "kind": "lifecycle",
        "initial": {
          "active": true,
          "generation": 1,
          "payload": 2
        },
        "initialiser": 10,
        "operations": [
          "create"
        ],
        "expected": {
          "active": true,
          "generation": 1,
          "payload": 2
        }
      }
    },
    {
      "id": "repeated-create",
      "contract": "repeated create",
      "witness": {
        "kind": "lifecycle",
        "initial": {
          "active": false,
          "generation": 0,
          "payload": null
        },
        "initialiser": 10,
        "operations": [
          "create",
          "create"
        ],
        "expected": {
          "active": true,
          "generation": 1,
          "payload": 10
        }
      }
    },
    {
      "id": "fresh-generation",
      "contract": "fresh generation",
      "witness": {
        "kind": "lifecycle",
        "initial": {
          "active": true,
          "generation": 1,
          "payload": 2
        },
        "initialiser": 10,
        "operations": [
          "destroy",
          "create"
        ],
        "expected": {
          "active": true,
          "generation": 2,
          "payload": 10
        }
      }
    },
    {
      "id": "redundant-destroy",
      "contract": "redundant destroy",
      "witness": {
        "kind": "lifecycle",
        "initial": {
          "active": false,
          "generation": 0,
          "payload": null
        },
        "initialiser": 10,
        "operations": [
          "destroy"
        ],
        "expected": {
          "active": false,
          "generation": 0,
          "payload": null
        }
      }
    },
    {
      "id": "different-dictionary-keys",
      "contract": "different dictionary keys",
      "witness": {
        "kind": "dictionary",
        "initial": {
          "a": "Red"
        },
        "proposals": [
          [
            "set",
            "b",
            "Blue"
          ],
          [
            "set",
            "c",
            "Green"
          ]
        ],
        "unique": false,
        "expected": {
          "a": "Red",
          "b": "Blue",
          "c": "Green"
        }
      }
    },
    {
      "id": "same-key-deletion",
      "contract": "same key deletion",
      "witness": {
        "kind": "dictionary",
        "initial": {
          "a": "Red"
        },
        "proposals": [
          [
            "set",
            "a",
            "Blue"
          ],
          [
            "delete",
            "a"
          ]
        ],
        "unique": false,
        "expected": {}
      }
    },
    {
      "id": "dictionary-value-conflict",
      "contract": "dictionary value conflict",
      "witness": {
        "kind": "dictionary",
        "initial": {
          "a": "Red"
        },
        "proposals": [
          [
            "set",
            "a",
            "Blue"
          ],
          [
            "set",
            "a",
            "Green"
          ]
        ],
        "unique": false,
        "expected": "conflict"
      }
    },
