-- MUD 1.0 — Contrato del AST tipado y elaborado
--
-- Se construye a partir de mud-resolved-ast.asdl después del tipado y la
-- elaboración. Conserva símbolos resueltos y añade tipos, dominios, formas
-- efectivas, conversiones y evidencias de análisis.

module MUDElaborated {

    source_span = (string source, int start, int end)

    anchor = (string canonical)

    symbol_id = AnchoredSymbol(anchor value)
              | LocalSymbol(anchor owner, string kind, string name, int ordinal)

    action_access = PublicAction | Subaction

    decision_mode = FirstMatch | AllMatches

    decision_branch_key = (symbol_id dictionary, string canonical_selector)

    dictionary_set_operator = DictionaryUnion
                            | DictionaryIntersection
                            | DictionaryDifference
                            | DictionarySymmetricDifference

    cardinality_origin = ExplicitCardinality
                       | OrdinaryScalarDefault
                       | InferredFromInitializer
                       | DerivedFromDecisionBranches

    metadata_kind = IntrinsicMetadata(string name)
                  | NameMetadata | PrivateMetadata | SummaryMetadata | DescriptionMetadata | DeprecatedMetadata
                  | PluralMetadata | AbbreviationMetadata | PrefixesMetadata | FormatMetadata
                  | ExtensionMetadata(string name)

    metadata_evaluation = StoredMetadata | CalculatedMetadata

    elaborated_project = ElaboratedProject(elaborated_decl* declarations,
                                       elaborated_decision_branch* decision_branches,
                                       dependency_edge* dependencies)

    elaborated_decl = ElaboratedDecl(anchor identity,
                                 string category,
                                 action_access? action_visibility,
                                 elaborated_type? declared_type,
                                 elaborated_metadata* metadata,
                                 elaborated_member* members)
        attributes (source_span origin)

    elaborated_member = ElaboratedMember(symbol_id identity,
                                     string category,
                                     elaborated_type? declared_type,
                                     elaborated_metadata* metadata,
                                     elaborated_expr? value)
        attributes (source_span origin)

    elaborated_metadata = ElaboratedMetadata(anchor identity,
                                         symbol_id owner,
                                         metadata_kind kind,
                                         elaborated_type type,
                                         metadata_evaluation evaluation,
                                         elaborated_expr value)
        attributes (source_span origin)

    elaborated_type = UnionType(type_alternative first,
                              type_alternative* remaining,
                              collection_shape collection)
                  | AnyValueType
                  | PositionalProductType(elaborated_type first,
                                          elaborated_type second,
                                          elaborated_type* remaining)
                  | NamedProductType(named_type_component first,
                                     named_type_component* remaining)
                  | ExactDictionaryType(elaborated_type key_type,
                                        elaborated_type value_type,
                                        collection_shape entries)
                  | DecisionDictionaryType(elaborated_type input_type,
                                           elaborated_type output_type,
                                           decision_shape decision)
        attributes (source_span origin)

    named_type_component = (string name, elaborated_type type)

    type_alternative = (anchor nominal_type, elaborated_domain? domain)

    elaborated_domain = IntervalDomain(elaborated_expr lower,
                                     elaborated_expr upper,
                                     string boundaries)
                    | SteppedDomain(elaborated_domain interval,
                                    elaborated_expr step)
                    | FiniteDomain(elaborated_expr* members)
                    | NamedDomain(anchor declaration)
                    | UnionDomain(elaborated_domain left, elaborated_domain right)
                    | IntersectionDomain(elaborated_domain left, elaborated_domain right)
                    | DifferenceDomain(elaborated_domain left, elaborated_domain right)
                    | SymmetricDifferenceDomain(elaborated_domain left,
                                                elaborated_domain right)

    collection_shape = (int? lower,
                        int? upper,
                        string multiplicity,
                        string order,
                        string capability,
                        cardinality_origin origin)

    decision_shape = (decision_mode mode,
                      string semantic_order,
                      string fallback,
                      string result_uniqueness,
                      collection_shape application_result,
                      termination_evidence* termination)

    termination_evidence = NumericDescent(symbol_id measure)
                         | CardinalityDescent(symbol_id measure)
                         | StructuralDescent(symbol_id measure)
                         | ExternalProof(string identity)

    elaborated_decision_branch = ElaboratedDecisionBranch(decision_branch_key key,
                                                       int source_ordinal,
                                                       string is_fallback,
                                                       elaborated_expr selector,
                                                       elaborated_expr result,
                                                       symbol_id* external_reads)
        attributes (source_span origin)

    elaborated_start_set = ElaboratedStartSet(anchor* things, anchor* rules)
        attributes (source_span origin)

    elaborated_expr = ReferenceExpr(symbol_id target)
                  | LiteralExpr(string kind, string canonical)
                  | EmptyExpr(elaborated_type expected_shape)
                  | AllExpr(elaborated_domain expected_domain, string stability)
                  | CollectionExpr(elaborated_expr* elements)
                  | PositionalProductExpr(elaborated_expr first,
                                          elaborated_expr second,
                                          elaborated_expr* remaining)
                  | NamedProductExpr(named_expr_component first,
                                     named_expr_component* remaining)
                  | ExactAssociationExpr(elaborated_expr key, elaborated_expr value)
                  | DecisionBranchExpr(elaborated_expr selector, elaborated_expr result)
                  | ExactLookupExpr(elaborated_expr dictionary, elaborated_expr key)
                  | DecisionApplyExpr(elaborated_expr dictionary,
                                      elaborated_expr input,
                                      decision_mode mode,
                                      collection_shape result_shape)
                  | ExactDictionarySetOperationExpr(dictionary_set_operator operator,
                                                    elaborated_expr left,
                                                    elaborated_expr right,
                                                    elaborated_type result_type)
                  | FunctionalDictionarySetOperationExpr(dictionary_set_operator operator,
                                                         elaborated_expr left,
                                                         elaborated_expr right,
                                                         elaborated_type result_type)
                  | MetadataAccessExpr(elaborated_expr receiver,
                                       metadata_kind metadata,
                                       elaborated_type result_type)
                  | OperationExpr(string operator, elaborated_expr* operands)
                  | ConversionExpr(elaborated_expr value, anchor target_type)
                  | TypeTestExpr(elaborated_expr value,
                                 anchor tested_type,
                                 string polarity)
                  | ExactNominalTypeTestExpr(elaborated_expr value,
                                             anchor tested_type,
                                             string polarity)
                  | NarrowedExpr(elaborated_expr value,
                                 elaborated_type narrowed_type)
        attributes (source_span origin)

    named_expr_component = (string name, elaborated_expr value)

    -- Specializes se aplica tanto a thing como a alias. Los miembros
    -- heredados conservan su AnchoredSymbol de origen.
    dependency_edge = Owns(symbol_id source, symbol_id target)
                    | Specializes(anchor source, anchor target)
                    | RefersTo(symbol_id source, symbol_id target)
                    | HasType(symbol_id source, anchor target)
                    | HasDomain(symbol_id source, symbol_id target)
                    | InitializesFrom(symbol_id source, symbol_id target)
                    | CalculatesFrom(symbol_id source, symbol_id target)
                    | Reads(symbol_id source, symbol_id target)
                    | ReadsMetadata(symbol_id source, symbol_id target, metadata_kind metadata)
                    | Writes(symbol_id source, symbol_id target)
                    | CallsAction(anchor source, anchor target)
                    | CallsDecision(anchor source, anchor target)
                    | DecisionDependsOn(decision_branch_key branch, symbol_id target)
                    | Creates(symbol_id source, anchor target)
                    | Destroys(symbol_id source, anchor target)
                    | UnitOf(anchor unit, anchor magnitude)
}
