-- MUD 1.0 — Contrato del IR semántico elaborado
--
-- Se reconstruye desde el AST superficial después de resolución nominal, tipado y elaboración.
-- Conserva significado semántico, símbolos/anclas resueltos y procedencia de fuente.

module MUDSemanticIR {

    source_span = (string source, int start, int end)

    anchor = (string canonical)

    flag = Disabled | Enabled

    symbol_id = AnchoredSymbol(anchor value)
              | LocalSymbol(anchor owner, string kind, string name, int ordinal)

    declaration_kind = ThingDeclaration
                     | AliasDeclaration
                     | FamilyDeclaration
                     | MagnitudeDeclaration
                     | BooleanRuleDeclaration
                     | ReactiveRuleDeclaration
                     | AlwaysRuleDeclaration
                     | ActionDeclaration
                     | SubactionDeclaration
                     | LookDeclaration
                     | MessageDeclaration
                     | TestDeclaration

    lifecycle_kind = AlwaysEffective | LifecycleControlled

    participant_binding = IdentityBinding | ValueBinding | PlaceBinding

    decision_mode = FirstMatch | AllMatches

    decision_branch_key = SelectorBranchKey(string canonical_selector)
                        | FallbackBranchKey

    dictionary_set_operator = DictionaryUnion
                            | DictionaryIntersection
                            | DictionaryDifference
                            | DictionarySymmetricDifference

    accumulation_operator = AdditiveIncrease
                          | AdditiveDecrease
                          | MultiplicativeUpdate
                          | CollectionUnionUpdate
                          | CollectionIntersectionUpdate
                          | CollectionSymmetricDifferenceUpdate
                          | CollectionDifferenceUpdate

    cardinality_origin = ExplicitCardinality
                       | OrdinaryScalarDefault
                       | InferredFromInitializer
                       | DerivedFromDecisionBranches

    metadata_kind = NameMetadata | SummaryMetadata | DescriptionMetadata | DeprecatedMetadata
                  | PluralMetadata | AbbreviationMetadata | PrefixesMetadata | FormatMetadata
                  | ExtensionMetadata(string name)

    metadata_property = IntrinsicProperty(string name)
                      | ConfiguredProperty(metadata_kind kind)

    metadata_evaluation = StoredMetadata | CalculatedMetadata

    output_evaluation = CallerViewEvaluation
                      | CausalAndStableHostEvaluation

    semantic_project = SemanticProject(string schema_version,
                                       semantic_module* modules,
                                       semantic_decl* declarations,
                                       semantic_decision_branch* decision_branches,
                                       dependency_edge* dependencies)

    semantic_module = SemanticModule(string logical_path,
                                     string* uses,
                                     semantic_start_set initial_activation)
        attributes (source_span origin)

    semantic_decl = SemanticDecl(anchor identity,
                                 string module_path,
                                 declaration_kind kind,
                                 lifecycle_kind lifecycle,
                                 semantic_signature signature,
                                 semantic_type? declared_type,
                                 semantic_metadata* metadata,
                                 semantic_member* members,
                                 semantic_behavior? behavior)
        attributes (source_span origin)

    semantic_signature = SemanticSignature(semantic_participant* for_participants,
                                           semantic_on_pattern? on_pattern,
                                           semantic_given* givens)

    semantic_participant = SemanticParticipant(symbol_id identity,
                                               int source_ordinal,
                                               semantic_type type,
                                               semantic_domain? domain,
                                               collection_shape collection,
                                               flag outer_mutable,
                                               participant_binding binding,
                                               anchor? nominal_refinement,
                                               semantic_expr? related_source)
        attributes (source_span origin)

    semantic_on_pattern = SemanticOnPattern(semantic_participant* participants,
                                            semantic_expr* joint_constraints)
        attributes (source_span origin)

    semantic_given = SemanticGiven(symbol_id identity,
                                   int source_ordinal,
                                   semantic_type type,
                                   semantic_domain? domain,
                                   collection_shape collection,
                                   semantic_expr? static_default)
        attributes (source_span origin)

    semantic_member = SemanticMember(symbol_id identity,
                                     string category,
                                     semantic_type? declared_type,
                                     flag outer_mutable,
                                     semantic_metadata* metadata,
                                     semantic_expr? value)
        attributes (source_span origin)

    semantic_metadata = SemanticMetadata(anchor identity,
                                         symbol_id owner,
                                         metadata_kind kind,
                                         semantic_type type,
                                         metadata_evaluation evaluation,
                                         semantic_expr value)
        attributes (source_span origin)

    semantic_type = UnionType(type_alternative first,
                              type_alternative* remaining,
                              collection_shape collection)
                  | AnyValueType
                  | CallableType(string category,
                                 semantic_type* receivers,
                                 semantic_type* givens)
                  | PositionalProductType(semantic_type first,
                                          semantic_type second,
                                          semantic_type* remaining)
                  | NamedProductType(named_type_component first,
                                     named_type_component* remaining)
                  | ExactDictionaryType(semantic_type key_type,
                                        semantic_type value_type,
                                        collection_shape entries)
                  | DecisionDictionaryType(semantic_type input_type,
                                           semantic_type output_type,
                                           decision_shape decision)
        attributes (source_span origin)

    named_type_component = (string name, semantic_type type)

    type_alternative = (anchor nominal_type, semantic_domain? domain)

    semantic_domain = IntervalDomain(semantic_expr lower,
                                     semantic_expr upper,
                                     string boundaries)
                    | SteppedDomain(semantic_domain interval,
                                    semantic_expr step)
                    | FiniteDomain(semantic_expr* members)
                    | NamedDomain(anchor declaration)
                    | UnionDomain(semantic_domain left, semantic_domain right)
                    | IntersectionDomain(semantic_domain left, semantic_domain right)
                    | DifferenceDomain(semantic_domain left, semantic_domain right)
                    | SymmetricDifferenceDomain(semantic_domain left,
                                                semantic_domain right)

    collection_shape = (int? lower,
                        int? upper,
                        string multiplicity,
                        string order,
                        flag member_mutable,
                        cardinality_origin origin)

    decision_shape = (decision_mode mode,
                      string semantic_order,
                      string fallback,
                      string result_uniqueness,
                      collection_shape application_result,
                      termination_evidence* termination)

    termination_evidence = NumericDescent(symbol_id measure)
                         | CardinalityDescent(symbol_id measure)
                         | StructuralDescent(symbol_id measure)
                         | ExternalProof(string identity)

    semantic_decision_branch = SemanticDecisionBranch(decision_branch_key key,
                                                       anchor dictionary,
                                                       int source_ordinal,
                                                       semantic_expr selector,
                                                       semantic_expr result,
                                                       symbol_id* external_reads)
        attributes (source_span origin)

    semantic_start_set = SemanticStartSet(anchor* declarations)
        attributes (source_span origin)

    semantic_behavior = BooleanRuleBehavior(semantic_expression_block condition)
                      | ReactiveRuleBehavior(semantic_local_binding* leading_locals,
                                             semantic_expression_block activator,
                                             semantic_expression_block? guard,
                                             semantic_effect_block effects)
                      | AlwaysRuleBehavior(semantic_expression_block invariant,
                                           semantic_expr? diagnostic)
                      | ActionBehavior(semantic_local_binding* leading_locals,
                                       semantic_expression_block? guard,
                                       semantic_effect_block effects,
                                       semantic_expression_block? postcondition)
                      | LookBehavior(semantic_output output)
                      | MessageBehavior(semantic_local_binding* leading_locals,
                                        semantic_expression_block activator,
                                        semantic_expression_block? guard,
                                        semantic_output output)
                      | TestBehavior(semantic_start_set initial_activation,
                                     semantic_effect_block effects,
                                     semantic_test_assertion* assertions)

    semantic_output = SemanticOutput(output_evaluation evaluation,
                                     semantic_public_field* fields)
        attributes (source_span origin)

    semantic_public_field = SemanticPublicField(symbol_id identity,
                                                semantic_type type,
                                                semantic_expr value)
        attributes (source_span origin)

    semantic_test_assertion = SemanticTestAssertion(semantic_expression_block condition,
                                                     semantic_expr? diagnostic)
        attributes (source_span origin)

    semantic_expression_block = SemanticExpressionBlock(semantic_local_binding* locals,
                                                         semantic_expr result)
        attributes (source_span origin)

    semantic_local_binding = SemanticLocalBinding(symbol_id identity,
                                                  int source_ordinal,
                                                  semantic_type type,
                                                  semantic_expr value)
        attributes (source_span origin)

    semantic_effect_block = SemanticEffectBlock(semantic_effect_item* items)
        attributes (source_span origin)

    semantic_effect_item = LocalBindingItem(semantic_local_binding binding)
                         | EffectItem(semantic_effect effect)

    semantic_effect = AssignmentEffect(symbol_id target,
                                       semantic_expr value)
                    | AccumulationEffect(accumulation_operator operator,
                                         symbol_id target,
                                         semantic_expr value)
                    | AddToCollectionEffect(semantic_expr value,
                                            symbol_id target)
                    | RemoveFromCollectionEffect(semantic_expr value,
                                                 symbol_id target)
                    | CreateDeclarationEffect(anchor target)
                    | DestroyDeclarationEffect(anchor target)
                    | CallEffect(semantic_call call)
                    | ForEachEffect(semantic_expr source,
                                    semantic_expr? step,
                                    semantic_expression_block? filter,
                                    string iteration_order,
                                    semantic_effect_block body)
        attributes (source_span origin)

    semantic_call = SemanticCall(semantic_expr callable,
                                 receiver_argument* receivers,
                                 given_argument* givens)
        attributes (source_span origin)

    receiver_argument = PositionalReceiver(semantic_expr value)
                      | NamedReceiver(string name, semantic_expr value)

    given_argument = PositionalGivenArgument(semantic_expr value)
                   | NamedGivenArgument(string name, semantic_expr value)

    semantic_expr = ReferenceExpr(symbol_id target)
                  | LiteralExpr(string kind, string canonical)
                  | EmptyExpr(semantic_type expected_shape)
                  | AllExpr(semantic_domain expected_domain, string stability)
                  | CollectionExpr(semantic_expr* elements)
                  | PositionalProductExpr(semantic_expr first,
                                          semantic_expr second,
                                          semantic_expr* remaining)
                  | NamedProductExpr(named_expr_component first,
                                     named_expr_component* remaining)
                  | ExactAssociationExpr(semantic_expr key, semantic_expr value)
                  | DecisionBranchExpr(semantic_expr selector, semantic_expr result)
                  | ExactLookupExpr(semantic_expr dictionary, semantic_expr key)
                  | DecisionApplyExpr(semantic_expr dictionary,
                                      semantic_expr input,
                                      decision_mode mode,
                                      collection_shape result_shape)
                  | ExactDictionarySetOperationExpr(dictionary_set_operator operator,
                                                    semantic_expr left,
                                                    semantic_expr right,
                                                    semantic_type result_type)
                  | FunctionalDictionarySetOperationExpr(dictionary_set_operator operator,
                                                         semantic_expr left,
                                                         semantic_expr right,
                                                         semantic_type result_type)
                  | MetadataAccessExpr(semantic_expr receiver,
                                       metadata_property metadata,
                                       semantic_type result_type)
                  | CallExpr(semantic_call call)
                  | AllowedExpr(semantic_call call)
                  | EventuallyExpr(semantic_expr goal,
                                   anchor* through_actions)
                  | OldExpr(semantic_expr value)
                  | OperationExpr(string operator, semantic_expr* operands)
                  | ContextualAliasConstructionExpr(semantic_expr literal, anchor target_alias)
                  | ConversionExpr(semantic_expr value, anchor target_type)
                  | TypeTestExpr(semantic_expr value,
                                 anchor tested_type,
                                 string polarity)
                  | ExactNominalTypeTestExpr(semantic_expr value,
                                             anchor tested_type,
                                             string polarity)
                  | NarrowedExpr(semantic_expr value,
                                 semantic_type narrowed_type)
        attributes (source_span origin)

    named_expr_component = (string name, semantic_expr value)

    -- Specializes se aplica tanto a thing como a alias. Los miembros
    -- heredados conservan su AnchoredSymbol de origen.
    dependency_edge = Owns(symbol_id source, symbol_id target)
                    | Specializes(anchor source, anchor target)
                    | RefersTo(symbol_id source, symbol_id target)
                    | HasType(symbol_id source, anchor target)
                    | HasDomain(symbol_id source, symbol_id target)
                    | InitializesFrom(symbol_id source, symbol_id target)
                    | CalculatesFrom(symbol_id source, symbol_id target)
                    | Reads(symbol_id source, symbol_id target)
                    | ReadsMetadata(symbol_id source, symbol_id target, metadata_kind metadata)
                    | Writes(symbol_id source, symbol_id target)
                    | QueriesRule(symbol_id source, anchor target)
                    | WhenDependsOn(symbol_id source, symbol_id target)
                    | IfDependsOn(symbol_id source, symbol_id target)
                    | AfterDependsOn(symbol_id source, symbol_id target)
                    | OldDependsOn(symbol_id source, symbol_id target)
                    | AlwaysDependsOn(symbol_id source, symbol_id target)
                    | DomainDependsOn(symbol_id source, symbol_id target)
                    | CallsAction(anchor source, anchor target)
                    | CallsCallable(symbol_id source, symbol_id target)
                    | CallsTest(anchor source, anchor target)
                    | BindsParticipant(symbol_id source, symbol_id target)
                    | CallsDecision(anchor source, anchor target)
                    | DecisionDependsOn(anchor dictionary, decision_branch_key branch, symbol_id target)
                    | AllowedDependsOn(symbol_id source, anchor target)
                    | EventuallyDependsOn(symbol_id source, anchor target)
                    | Creates(symbol_id source, anchor target)
                    | Destroys(symbol_id source, anchor target)
                    | AddsTo(symbol_id source, symbol_id target)
                    | RemovesFrom(symbol_id source, symbol_id target)
                    | StochasticDependsOn(symbol_id source, symbol_id target)
                    | HardDependsOn(symbol_id source, symbol_id target)
                    | ProducesLookField(anchor look, symbol_id field)
                    | ReadsLook(symbol_id source, anchor look)
                    | ProducesMessageField(anchor message, symbol_id field)
                    | ReadsMessage(symbol_id source, anchor message)
                    | TestActivates(anchor test, anchor target)
                    | TestReads(anchor test, symbol_id target)
                    | TestWrites(anchor test, symbol_id target)
                    | TestDiagnoses(anchor test, symbol_id target)
                    | DerivesDimension(anchor source, anchor target)
                    | PointOver(anchor point, anchor linear)
                    | UnitEquivalent(anchor source, anchor target)
                    | UnitOf(anchor unit, anchor magnitude)
}

-- La codificación interna de matches causales de trigger permanece fuera de este
-- contrato mientras no exista una forma normativa que deba conservar el IR.
