-- MUD 1.0 — Contrato del IR semántico elaborado
--
-- Se reconstruye desde el AST superficial después de resolución nominal, tipado y elaboración.
-- Conserva significado semántico, símbolos/anclas resueltos y procedencia de fuente.

module MUDSemanticIR {

    source_span = (string source, int start, int end)

    anchor = (string canonical)

    symbol_id = AnchoredSymbol(anchor value)
              | LocalSymbol(anchor owner, string kind, string name, int ordinal)

    action_access = PublicAction | Subaction

    decision_mode = FirstMatch | AllMatches

    decision_branch_key = SelectorBranchKey(string canonical_selector)
                        | FallbackBranchKey

    dictionary_set_operator = DictionaryUnion
                            | DictionaryIntersection
                            | DictionaryDifference
                            | DictionarySymmetricDifference

    cardinality_origin = ExplicitCardinality
                       | OrdinaryScalarDefault
                       | InferredFromInitializer
                       | DerivedFromDecisionBranches

    metadata_kind = NameMetadata | PrivateMetadata | SummaryMetadata | DescriptionMetadata | DeprecatedMetadata
                  | PluralMetadata | AbbreviationMetadata | PrefixesMetadata | FormatMetadata
                  | ExtensionMetadata(string name)

    metadata_property = IntrinsicProperty(string name)
                      | ConfiguredProperty(metadata_kind kind)

    metadata_evaluation = StoredMetadata | CalculatedMetadata

    semantic_project = SemanticProject(semantic_decl* declarations,
                                       semantic_decision_branch* decision_branches,
                                       dependency_edge* dependencies)

    semantic_decl = SemanticDecl(anchor identity,
                                 string category,
                                 action_access? action_visibility,
                                 semantic_type? declared_type,
                                 semantic_metadata* metadata,
                                 semantic_member* members)
        attributes (source_span origin)

    semantic_member = SemanticMember(symbol_id identity,
                                     string category,
                                     semantic_type? declared_type,
                                     semantic_metadata* metadata,
                                     semantic_expr? value)
        attributes (source_span origin)

    semantic_metadata = SemanticMetadata(anchor identity,
                                         symbol_id owner,
                                         metadata_kind kind,
                                         semantic_type type,
                                         metadata_evaluation evaluation,
                                         semantic_expr value)
        attributes (source_span origin)

    semantic_type = UnionType(type_alternative first,
                              type_alternative* remaining,
                              collection_shape collection)
                  | AnyValueType
                  | PositionalProductType(semantic_type first,
                                          semantic_type second,
                                          semantic_type* remaining)
                  | NamedProductType(named_type_component first,
                                     named_type_component* remaining)
                  | ExactDictionaryType(semantic_type key_type,
                                        semantic_type value_type,
                                        collection_shape entries)
                  | DecisionDictionaryType(semantic_type input_type,
                                           semantic_type output_type,
                                           decision_shape decision)
        attributes (source_span origin)

    named_type_component = (string name, semantic_type type)

    type_alternative = (anchor nominal_type, semantic_domain? domain)

    semantic_domain = IntervalDomain(semantic_expr lower,
                                     semantic_expr upper,
                                     string boundaries)
                    | SteppedDomain(semantic_domain interval,
                                    semantic_expr step)
                    | FiniteDomain(semantic_expr* members)
                    | NamedDomain(anchor declaration)
                    | UnionDomain(semantic_domain left, semantic_domain right)
                    | IntersectionDomain(semantic_domain left, semantic_domain right)
                    | DifferenceDomain(semantic_domain left, semantic_domain right)
                    | SymmetricDifferenceDomain(semantic_domain left,
                                                semantic_domain right)

    collection_shape = (int? lower,
                        int? upper,
                        string multiplicity,
                        string order,
                        string capability,
                        cardinality_origin origin)

    decision_shape = (decision_mode mode,
                      string semantic_order,
                      string fallback,
                      string result_uniqueness,
                      collection_shape application_result,
                      termination_evidence* termination)

    termination_evidence = NumericDescent(symbol_id measure)
                         | CardinalityDescent(symbol_id measure)
                         | StructuralDescent(symbol_id measure)
                         | ExternalProof(string identity)

    semantic_decision_branch = SemanticDecisionBranch(decision_branch_key key,
                                                       anchor dictionary,
                                                       int source_ordinal,
                                                       semantic_expr selector,
                                                       semantic_expr result,
                                                       symbol_id* external_reads)
        attributes (source_span origin)

    semantic_start_set = SemanticStartSet(anchor* things, anchor* rules)
        attributes (source_span origin)

    semantic_expr = ReferenceExpr(symbol_id target)
                  | LiteralExpr(string kind, string canonical)
                  | EmptyExpr(semantic_type expected_shape)
                  | AllExpr(semantic_domain expected_domain, string stability)
                  | CollectionExpr(semantic_expr* elements)
                  | PositionalProductExpr(semantic_expr first,
                                          semantic_expr second,
                                          semantic_expr* remaining)
                  | NamedProductExpr(named_expr_component first,
                                     named_expr_component* remaining)
                  | ExactAssociationExpr(semantic_expr key, semantic_expr value)
                  | DecisionBranchExpr(semantic_expr selector, semantic_expr result)
                  | ExactLookupExpr(semantic_expr dictionary, semantic_expr key)
                  | DecisionApplyExpr(semantic_expr dictionary,
                                      semantic_expr input,
                                      decision_mode mode,
                                      collection_shape result_shape)
                  | ExactDictionarySetOperationExpr(dictionary_set_operator operator,
                                                    semantic_expr left,
                                                    semantic_expr right,
                                                    semantic_type result_type)
                  | FunctionalDictionarySetOperationExpr(dictionary_set_operator operator,
                                                         semantic_expr left,
                                                         semantic_expr right,
                                                         semantic_type result_type)
                  | MetadataAccessExpr(semantic_expr receiver,
                                       metadata_property metadata,
                                       semantic_type result_type)
                  | OperationExpr(string operator, semantic_expr* operands)
                  | ConversionExpr(semantic_expr value, anchor target_type)
                  | TypeTestExpr(semantic_expr value,
                                 anchor tested_type,
                                 string polarity)
                  | ExactNominalTypeTestExpr(semantic_expr value,
                                             anchor tested_type,
                                             string polarity)
                  | NarrowedExpr(semantic_expr value,
                                 semantic_type narrowed_type)
        attributes (source_span origin)

    named_expr_component = (string name, semantic_expr value)

    -- Specializes se aplica tanto a thing como a alias. Los miembros
    -- heredados conservan su AnchoredSymbol de origen.
    dependency_edge = Owns(symbol_id source, symbol_id target)
                    | Specializes(anchor source, anchor target)
                    | RefersTo(symbol_id source, symbol_id target)
                    | HasType(symbol_id source, anchor target)
                    | HasDomain(symbol_id source, symbol_id target)
                    | InitializesFrom(symbol_id source, symbol_id target)
                    | CalculatesFrom(symbol_id source, symbol_id target)
                    | Reads(symbol_id source, symbol_id target)
                    | ReadsMetadata(symbol_id source, symbol_id target, metadata_kind metadata)
                    | Writes(symbol_id source, symbol_id target)
                    | CallsAction(anchor source, anchor target)
                    | CallsDecision(anchor source, anchor target)
                    | DecisionDependsOn(anchor dictionary, decision_branch_key branch, symbol_id target)
                    | Creates(symbol_id source, anchor target)
                    | Destroys(symbol_id source, anchor target)
                    | UnitOf(anchor unit, anchor magnitude)
}
