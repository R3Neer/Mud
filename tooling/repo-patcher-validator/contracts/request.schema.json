{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mud.example/schemas/repo-patcher-validation-request-v1.json",
  "title": "MUD RepoPatcher validation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "repository",
    "target_sha",
    "package_sha256",
    "package_size",
    "trust_plugin",
    "transport_kind"
  ],
  "properties": {
    "protocol": { "const": "mud-repo-patcher-validation/v1" },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "repository": { "const": "R3Neer/Mud" },
    "target_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "package_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "package_size": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "trust_plugin": { "type": "boolean" },
    "transport_kind": {
      "type": "string",
      "enum": ["zip_base64", "logical_files", "files_staged_v1"]
    }
  }
}
