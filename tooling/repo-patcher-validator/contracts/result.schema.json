{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mud.example/schemas/repo-patcher-validation-result-v1.json",
  "title": "MUD RepoPatcher validation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "workflow_run_id",
    "run_attempt",
    "control_sha",
    "target_sha",
    "package_sha256",
    "package_size",
    "runtime_version",
    "conclusion",
    "failure_kind",
    "artifact_files"
  ],
  "properties": {
    "protocol": { "const": "mud-repo-patcher-validation-result/v1" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "workflow_run_id": { "type": "integer", "minimum": 1 },
    "run_attempt": { "type": "integer", "minimum": 1 },
    "control_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "package_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "package_size": { "type": "integer", "minimum": 1 },
    "runtime_version": {
      "anyOf": [
        { "const": "0.2.0" },
        { "type": "null" }
      ]
    },
    "conclusion": { "enum": ["success", "failure", "infrastructure_error"] },
    "failure_kind": { "type": ["string", "null"] },
    "preflight_command": { "type": ["string", "null"] },
    "diagnostic": { "type": "string" },
    "artifact_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
