{
  "name": "mud-repo-patcher-validator-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types:check && npm run typecheck && npm test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply mud-repo-patcher-validator --local",
    "migrate:remote": "wrangler d1 migrations apply mud-repo-patcher-validator --remote",
    "smoke:mcp": "node scripts/run_mcp_smoke.mjs",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts --include-runtime false",
    "types:check": "wrangler types worker-configuration.d.ts --include-runtime false --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "fflate": "0.8.3",
    "jose": "6.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@cloudflare/workers-types": "5.20260810.1",
    "@modelcontextprotocol/client": "2.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  }
}
