{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mud-repo-patcher-mcp-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "PROBE_BUCKET",
      "bucket_name": "mud-repo-patcher-mcp-probe",
      "preview_bucket_name": "mud-repo-patcher-mcp-probe-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
