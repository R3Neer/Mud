{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mud-repo-patcher-mcp-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PROBE_ROUTE_SECRET": "local-probe"
  },
  "r2_buckets": [
    {
      "binding": "PROBE_BUCKET",
      "bucket_name": "mud-repo-patcher-mcp-probe",
      "preview_bucket_name": "mud-repo-patcher-mcp-probe-preview"
    }
  ],
  "observability": {
    "enabled": true
  }
}
